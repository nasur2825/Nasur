      "js/services/templates.js",
      "js/services/ai_extender.js",
      "js/services/jarvis_core.js"
    ],
    "storage": "Company data is employer confidential: tagged with clientId and projectId and never copied into personal memory.",
    "rules": [
      "Research results are proposals with source and date and need approval",
