{
  "schema_version": 2,
  "name": "NASUR Personal HSE Operating System",
  "tagline": "Lifelong JARVIS bloodline: one core, many industries, memory only with approval",
  "mission": {
    "title": "Core Mission: protect the workers and their families",
    "statement": "JARVIS exists to help protect the 3000+ workers and 3000+ families who depend on them under the user's responsibility, and to become the number one safety AI for the field professional.",
    "audience": {
      "workers": "3000+",
      "families": "3000+"
    },
    "priorities": [
      "Human life first",
      "Prevention before reaction",
      "Practical field clarity above bureaucracy",
      "Honest advice even when it is uncomfortable"
    ],
    "rules": [
      "Every feature, alert and recommendation must be judged by whether it protects people",
      "Keep answers short, clear and usable on the shop floor",
      "Paperwork supports safety, never replaces it",
      "The official site procedure and emergency plan always come first"
    ],
    "applies_to": [
      "alerts",
      "recommendations",
      "reports",
      "learning",
      "check-ins"
    ]
  },
  "storage_rule": "All records use the existing IndexedDB stores. Memory scopes live in memory_notes with a kind field. No new database redesign is needed for Phases 4 to 12.",
  "memory_scopes": [
    {
      "id": "temporary_session",
      "title": "Temporary Session",
      "store": "session (RAM + sessionStorage)",
      "summary": "Current chat or screen context. Cleared on reset or when the browser tab closes.",
      "persists": false
    },
    {
      "id": "approved_personal_memory",
      "title": "Approved Personal Memory",
      "store": "memory_notes kind=personal_memory",
      "summary": "Saved only after the user explicitly approves. The user can view, edit, delete each item, switch memory off, and roll back any AI generated change.",
      "persists": true,
      "categories": [
        "name",
        "communication_style",
        "education",
        "career_timeline",
        "industries_worked",
        "difficult_topics",
        "completed_lessons",
        "repeated_questions",
        "lessons_learned",
        "preferred_languages_formats"
      ],
      "rules": [
        "Save only on explicit approval",
        "Never claim to remember anything that is not stored",
        "Memory can be switched off at any time"
      ]
    },
    {
      "id": "employer_confidential_data",
      "title": "Employer Confidential Data",
      "store": "memory_notes kind=employer_data",
      "summary": "Isolated per clientId and projectId. Never copied into personal memory automatically.",
      "persists": true,
      "rules": [
        "Always tagged with clientId or projectId",
        "Moving an achievement to the Career Portfolio shows a confidentiality removal reminder first",
        "Never sent to AI providers without approval"
      ]
    }
  ],
